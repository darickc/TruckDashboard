#!/bin/bash
# Copies an offline map, routing data and search data from a USB stick onto
# the data drive (ADR-0033; routing data: ADR-0033 amendment 2026-11-11,
# ADR-0035; search data: ADR-0038).
# f250-map-import@<dev>.service runs it when the udev rule
# 80-f250-map-stick.rules sees an exFAT or FAT stick; `make map-stick` on the
# Mac writes the stick.
#
#   map-import device /dev/sdX1   mount the stick read-only, then `dir`
#   map-import dir <dir>          import <dir>/f250/map.pmtiles,
#                                 <dir>/f250/routing.tar and/or
#                                 <dir>/f250/search.sqlite
#   map-import stopped /dev/sdX1  ExecStopPost: that stick's unfinished import
#                                 becomes "failed" (the stick was pulled)
#
# A stick carries any of these files, each with its .sha256 beside it:
#
#   f250/map.pmtiles   -> <storage>/maps/map.pmtiles             (the dashboard)
#   f250/routing.tar   -> <storage>/routing/valhalla_tiles.tar   (navigation)
#   f250/search.sqlite -> <storage>/search/search.sqlite         (navigation)
#
# Only those files and their checksums are read; nothing on the stick is run,
# and the stick is mounted ro,nosuid,nodev,noexec. A stick with neither is
# left alone, silently: it isn't a map stick. They go in that order; a
# failure stops the import there.
#
# Each new file is copied next to the old one as <name>.part, then checked
# (the checksum; for the map the PMTiles v3 header and a tile type the
# dashboard draws, for the routing data a tar with index.bin first, for the
# search data a SQLite file with application id "F250") and only
# then renamed over the old one. Any failure, a full drive or a pulled stick
# leaves the old file in place. Each installed file's SHA-256 is kept in
# <name>.sha256 beside it: a stick with the same file (one left in the truck,
# at every start) is not copied again ("current"). The dashboard reads the
# status file (JSON: state checking|copying|updated|current|failed, percent,
# message, id, device, item:
# map|routing|search, the file being checked or copied, and changed: the
# items the import replaced, also when it then failed) and opens the new map
# when it sees "updated", or "failed" after the map was swapped in, with a
# new id and "map" in changed. navigation notices new routing data by itself
# (it checks the file every second), and new search data at the next search.
#
# Testing: F250_STORAGE (the data drive's mount point), F250_MAP_STATUS_DIR
# (where status.json and the stick's mount point go), F250_MAP_REQUIRE_MOUNT=0
# (the drive needn't be a mount point), F250_SYS_LOG=<file> records mount and
# umount instead of running them (tools/dev/test-agl.sh). Works with macOS's
# bash 3.2 and BSD tools.
#
# Status: [SIM] (test-agl.sh). Not run on the Pi or with a real stick yet.
set -euo pipefail

STORAGE="${F250_STORAGE:-/var/lib/f250/storage}"
STATUS_DIR="${F250_MAP_STATUS_DIR:-/run/f250-maps}"
REQUIRE_MOUNT="${F250_MAP_REQUIRE_MOUNT:-1}"
STATUS="$STATUS_DIR/status.json"
LOCK="$STATUS_DIR/import.lock"
SPARE=$((64 * 1024 * 1024))   # left free on the drive after the copy

log() { echo "map-import: $*"; }

sys() {   # mount and umount: run them, or only record them under test
  if [[ -n "${F250_SYS_LOG:-}" ]]; then
    echo "$*" >>"$F250_SYS_LOG"
    return 0
  fi
  "$@"
}

json_str() { printf '"%s"' "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')"; }

ID="$(date -u +%Y%m%dT%H%M%SZ)-$$"
DEVICE=""      # the stick being imported, in the status (for `stopped`)
LOCKED=0
MOUNTED=""
ITEM=""        # map or routing: the file being checked or copied
CHANGED=()     # the items this import replaced
PART=""        # the copy in progress, removed on failure
RESULT=""

status() {   # status <state> <percent> <message>
  local tmp="$STATUS.$$" changed="" c
  mkdir -p "$STATUS_DIR"
  if [[ ${#CHANGED[@]} -gt 0 ]]; then
    for c in "${CHANGED[@]}"; do changed="$changed${changed:+,}$(json_str "$c")"; done
  fi
  printf '{"state":%s,"percent":%d,"message":%s,"id":%s,"device":%s,"item":%s,"changed":[%s],"at":%s}\n' \
    "$(json_str "$1")" "$2" "$(json_str "$3")" "$(json_str "$ID")" "$(json_str "$DEVICE")" \
    "$(json_str "$ITEM")" "$changed" "$(json_str "$(date -u +%Y-%m-%dT%H:%M:%SZ)")" >"$tmp"
  mv -f "$tmp" "$STATUS"
}

cleanup() {
  if [[ -n "$MOUNTED" ]]; then
    sys umount "$MOUNTED" || true
    rmdir "$MOUNTED" 2>/dev/null || true
  fi
  [[ "$LOCKED" == 1 ]] && rmdir "$LOCK" 2>/dev/null
  return 0
}
trap cleanup EXIT

fail() {
  local msg="$*"
  log "failed: $*"
  [[ -n "$PART" ]] && rm -f "$PART"
  # What came before it on the stick and was swapped in: say so.
  if [[ ${#CHANGED[@]} -gt 0 ]]; then
    local done=() c
    for c in "${CHANGED[@]}"; do
      case "$c" in map) done+=(map) ;; *) done+=("$c data") ;; esac
    done
    msg="$msg The $(join_and "${done[@]}") $(was_were ${#done[@]}) updated."
  fi
  status failed 0 "$msg"
  exit 1
}

size_of() { wc -c <"$1" | tr -d ' '; }

sha256() {
  if command -v sha256sum >/dev/null; then sha256sum "$1" | cut -d' ' -f1
  else shasum -a 256 "$1" | cut -d' ' -f1
  fi
}

# Why the dashboard couldn't show <file>, or nothing: a PMTiles v3 file of
# vector (1), PNG (2), JPEG (3) or WebP (4) tiles (the header's byte 99).
header_problem() {
  local f="$1" magic version type
  magic="$(head -c 7 "$f")"
  [[ "$magic" == PMTiles ]] || { echo "it isn't a PMTiles file"; return; }
  version="$(od -An -tu1 -j7 -N1 "$f" | tr -d ' ')"
  [[ "$version" == 3 ]] || { echo "it is PMTiles version $version, not 3"; return; }
  type="$(od -An -tu1 -j99 -N1 "$f" | tr -d ' ')"
  case "$type" in
    1|2|3|4) ;;
    *) echo "its tile type ($type) isn't vector, PNG, JPEG or WebP" ;;
  esac
}

# Why Valhalla couldn't use <file> as a tile extract, or nothing: a tar
# (ustar) whose first entry is index.bin, as valhalla_build_extract 3.9.1
# writes it (make route-region; checked on its Kansas build, 2026-11-11).
tar_problem() {
  local f="$1"
  [[ "$(od -An -c -j257 -N5 "$f" | tr -d ' ')" == ustar ]] || { echo "it isn't a tar file"; return; }
  [[ "$(head -c 10 "$f" | tr -d '\0')" == index.bin ]] || echo "it isn't a Valhalla tile extract (no index.bin first)"
}

# Why navigation couldn't search <file>, or nothing: a SQLite file whose
# application id (header bytes 68-71) is "F250", as make search-region writes
# it (crates/geocode, ADR-0038).
sqlite_problem() {
  local f="$1"
  [[ "$(head -c 15 "$f")" == "SQLite format 3" ]] || { echo "it isn't a SQLite file"; return; }
  [[ "$(od -An -c -j68 -N4 "$f" | tr -d ' ')" == F250 ]] || echo "it isn't navigation's search data"
}

# The items a stick can carry, each optional, imported in this order.
# item <name>: sets SRC_NAME (in <stick>/f250/), DEST_DIR, DEST_NAME, WHAT
# (for messages) and CHECK (the file check above).
item() {
  case "$1" in
    map) SRC_NAME=map.pmtiles; DEST_DIR="$STORAGE/maps"; DEST_NAME=map.pmtiles
         WHAT="the map"; CHECK=header_problem ;;
    routing) SRC_NAME=routing.tar; DEST_DIR="$STORAGE/routing"; DEST_NAME=valhalla_tiles.tar
             WHAT="the routing data"; CHECK=tar_problem ;;
    search) SRC_NAME=search.sqlite; DEST_DIR="$STORAGE/search"; DEST_NAME=search.sqlite
            WHAT="the search data"; CHECK=sqlite_problem ;;
  esac
  DEST="$DEST_DIR/$DEST_NAME"
  PART="$DEST.part"
  DEST_SUM="$DEST.sha256"   # the installed file's SHA-256, written by this script
}

cap() { printf '%s%s' "$(printf '%s' "${1:0:1}" | tr '[:lower:]' '[:upper:]')" "${1:1}"; }

# import_one <item> <stick dir>: check one file on the stick and copy it in.
# Sets RESULT to updated or current; any failure ends the script (fail).
import_one() {
  local name="$1" src="$2" file sum want got size free need copied pid problem msg
  ITEM="$name"
  item "$name"
  file="$src/f250/$SRC_NAME"
  sum="$file.sha256"
  msg="Copying $WHAT from USB: leave the stick in"
  status checking 0 "$(cap "$WHAT") on the stick: checking it"

  [[ -f "$sum" ]] || fail "The stick has f250/$SRC_NAME but no $SRC_NAME.sha256 (make map-stick writes both). The old ${WHAT#the } is kept."
  want="$(awk 'NR == 1 { print tolower($1) }' "$sum")"
  [[ "$want" =~ ^[0-9a-f]{64}$ ]] || fail "$SRC_NAME.sha256 on the stick isn't a SHA-256 checksum. The old ${WHAT#the } is kept."
  problem="$($CHECK "$file")"
  [[ -z "$problem" ]] || fail "$(cap "$WHAT") on the stick can't be used: $problem. The old ${WHAT#the } is kept."
  # A stick left in would otherwise copy the whole file again at every start.
  if [[ -f "$DEST" && -f "$DEST_SUM" && "$(cat "$DEST_SUM")" == "$want" \
        && "$(size_of "$DEST")" == "$(size_of "$file")" ]]; then
    log "$WHAT on $src is already installed (sha256 $want): nothing copied"
    RESULT=current
    return 0
  fi
  if [[ "$REQUIRE_MOUNT" != 0 ]] && ! findmnt -rn --mountpoint "$STORAGE" >/dev/null; then
    fail "The data drive isn't mounted at $STORAGE; $WHAT is kept on it. Nothing was copied."
  fi

  mkdir -p "$DEST_DIR"
  rm -f "$PART"   # a copy cut short by a power loss
  size="$(size_of "$file")"
  free="$(df -Pk "$DEST_DIR" | awk 'NR == 2 { print $4 }')"
  need=$(( (size + SPARE) / 1024 ))
  [[ "$free" -ge "$need" ]] || fail "Not enough room on the data drive: $WHAT needs $((need / 1024)) MB, $((free / 1024)) MB is free. The old ${WHAT#the } is kept."

  log "copying $file ($size bytes) to $PART"
  status copying 0 "$msg"
  cp "$file" "$PART" &
  pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    copied="$( [[ -f "$PART" ]] && size_of "$PART" || echo 0)"
    [[ "$size" -gt 0 ]] && status copying $(( copied * 100 / size )) "$msg"
    sleep 1
  done
  wait "$pid" || fail "Copying from the stick failed. The old ${WHAT#the } is kept."
  chmod 0644 "$PART"   # cp keeps the stick's modes (exFAT shows 0755)
  # cp can finish into the page cache long before the drive has it; sync is
  # the rest of the copy, and the stick must stay in until it's done.
  status copying 100 "$msg"
  sync

  status checking 100 "Checking the copied ${WHAT#the }"
  got="$(sha256 "$PART")"
  [[ "$got" == "$want" ]] || fail "The copied ${WHAT#the } doesn't match its checksum: the stick or the copy is bad. The old ${WHAT#the } is kept."
  problem="$($CHECK "$PART")"
  [[ -z "$problem" ]] || fail "The copied ${WHAT#the } can't be used: $problem. The old ${WHAT#the } is kept."

  # The installed file's checksum, so the same stick isn't copied again. Gone
  # before the swap and written after it, so it never names another file.
  rm -f "$DEST_SUM"
  mv -f "$PART" "$DEST"
  printf '%s\n' "$got" >"$DEST_SUM.$$" && mv -f "$DEST_SUM.$$" "$DEST_SUM"
  sync
  log "installed $DEST ($size bytes, sha256 $got)"
  RESULT=updated
}

join_and() {   # "a", "a and b", "a, b and c"
  local out="$1"
  shift
  while [[ $# -gt 1 ]]; do out="$out, $1"; shift; done
  [[ $# -eq 1 ]] && out="$out and $1"
  printf '%s' "$out"
}

is_are() { if [[ $1 -eq 1 ]]; then echo is; else echo are; fi; }
was_were() { if [[ $1 -eq 1 ]]; then echo was; else echo were; fi; }

import_dir() {
  local src="$1" name items=() changed=() current=() msg
  for name in map routing search; do
    item "$name"
    [[ -f "$src/f250/$SRC_NAME" ]] && items+=("$name")
  done
  if [[ ${#items[@]} -eq 0 ]]; then
    log "no f250/map.pmtiles, f250/routing.tar or f250/search.sqlite in $src: not a map stick, nothing to do"
    return 0
  fi
  mkdir -p "$STATUS_DIR"
  if ! mkdir "$LOCK" 2>/dev/null; then
    log "another import is running"; return 1
  fi
  LOCKED=1

  for name in "${items[@]}"; do
    import_one "$name" "$src"
    item "$name"
    if [[ "$RESULT" == updated ]]; then changed+=("${WHAT#the }"); CHANGED+=("$name")
    else current+=("${WHAT#the }"); fi
  done

  if [[ ${#changed[@]} -eq 0 ]]; then
    if [[ ${#current[@]} -eq 1 && "${current[0]}" == map ]]; then
      msg="This map is already installed. You can remove the stick."
    else
      msg="The $(join_and "${current[@]}") on this stick $(is_are ${#current[@]}) already installed. You can remove the stick."
    fi
    status current 100 "$msg"
    return 0
  fi
  msg="$(cap "$(join_and "${changed[@]}")") updated."
  [[ ${#current[@]} -gt 0 ]] && msg="$msg The $(join_and "${current[@]}") $(was_were ${#current[@]}) already installed."
  status updated 100 "$msg You can remove the stick."
}

stopped() {   # that stick's unit stopped: an import it left unfinished failed
  local dev="$1" state
  [[ -f "$STATUS" ]] || return 0
  state="$(sed -n 's/^{"state":"\([a-z]*\)".*/\1/p' "$STATUS")"
  grep -qF "\"device\":\"$dev\"" "$STATUS" || return 0   # another stick's import
  case "$state" in
    copying|checking)
      ITEM="$(sed -n 's/.*"item":"\([a-z]*\)".*/\1/p' "$STATUS")"
      [[ "$ITEM" == routing || "$ITEM" == search ]] || ITEM=map
      item "$ITEM"
      rm -f "$PART"
      ID="$(sed -n 's/.*"id":"\([^"]*\)".*/\1/p' "$STATUS")"
      DEVICE="$dev"
      status failed 0 "The stick was removed before ${WHAT} was copied. The old ${WHAT#the } is kept."
      rmdir "$LOCK" 2>/dev/null || true
      ;;
  esac
}

device() {
  local dev="$1" mnt
  [[ "$dev" == /dev/* ]] || { echo "map-import: $dev is not a device" >&2; exit 2; }
  DEVICE="$dev"
  mnt="$STATUS_DIR/stick-$(basename "$dev")"
  mkdir -p "$mnt"
  sys mount -t exfat,vfat -o ro,nosuid,nodev,noexec "$dev" "$mnt" || { log "can't mount $dev"; exit 1; }
  MOUNTED="$mnt"
  import_dir "$mnt"
}

case "${1:-}" in
  device) [[ $# -eq 2 ]] || { echo "usage: map-import device /dev/<node>" >&2; exit 2; }; device "$2" ;;
  dir) [[ $# -eq 2 ]] || { echo "usage: map-import dir <dir>" >&2; exit 2; }; import_dir "$2" ;;
  stopped) [[ $# -eq 2 ]] || { echo "usage: map-import stopped /dev/<node>" >&2; exit 2; }; stopped "$2" ;;
  *) echo "usage: map-import device /dev/<node> | dir <dir> | stopped /dev/<node>" >&2; exit 2 ;;
esac
