#!/bin/bash
# ExecStart of f250-audio-manager.service on AGL: audio-manager with the
# settings from /etc/default/f250 (ADR-0039).
#
#   AUDIO_SIMULATE      1: a simulated phone instead of BlueZ, and no
#                       filter-chain; labelled simulated on the screen.
#                       Default 0.
#   AUDIO_ADAPTER       the Bluetooth adapter. Default hci0.
#   AUDIO_NAME          the name phones see while pairing. Default F-250.
#   AUDIO_PAIR_WINDOW_S the pairing window's length, seconds. Default 120,
#                       an example.
#   AUDIO_DSP           0: no filter-chain (the speakers get the stereo mix
#                       straight from WirePlumber). Default 1.
#   AUDIO_DAC_NODE      the DAC's PipeWire node name (pw-cli ls Node);
#                       empty: the default sink. UNVERIFIED for the DAC8x.
#   AUDIO_DAC_POSITIONS the DAC's channel positions, in order. Default
#                       FL,FR,RL,RR,FC,LFE,SL,SR. UNVERIFIED for the DAC8x.
#   AUDIO_FRONT, AUDIO_REAR, AUDIO_SUB
#                       which DAC channels (0-based left,right) feed the
#                       front, rear and sub inputs. Defaults 0,1 / 2,3 /
#                       4,5: examples, found on the bench with a test tone
#                       (docs/wiring/audio.md).
#   AUDIO_CROSSOVER_HZ  the crossover's default (Defaults on the screen).
#                       Default 80, an example: tune it in the truck.
#   AUDIO_VOICE         spoken directions (navigation's prompts): a program
#                       that says its argument; "none": prompts are refused.
#                       Default /opt/f250/libexec/speak-prompt (Flite).
#   AUDIO_PROMPT_HOLD_MS  the music resumes this long after the last prompt.
#                       Default 1000, an example (owner, 2026-11-12).
#   AUDIO_RECONNECT_EVERY_S, AUDIO_RECONNECT_FOR_S
#                       with no phone connected, audio-manager tries the phone
#                       connected last every EVERY s for FOR s after start,
#                       Bluetooth coming back or the link dropping. Defaults
#                       20 and 300, examples; FOR 0: never by itself.
#   AUDIO_COVER_ART     1: the phone's cover art on the Media screen, through
#                       obexd (f250-obexd.service) into
#                       /run/f250-obex/cover-art (ADR-0042). 0: none.
#                       Default 1.
#   AUDIO_VOLUME_STEPS, AUDIO_VOLUME_STEP_DB
#                       the master volume's steps (the top one 0 dB) and dB
#                       a step (ADR-0043). Defaults 30 and 2, examples.
#   AUDIO_VOLUME_MAX    the highest level the driver may set. Default: the
#                       top step; an example: lower it for speakers that
#                       can't take the amplifiers' full output.
#   AUDIO_VOLUME_START_MAX  audio-manager starts no louder than this,
#                       whatever it saved. Default 15, an example.
#   AUDIO_KNOB          1: the volume knob from /dev/input (any device with
#                       the volume keys, play/pause or REL_DIAL). Default 1;
#                       0: none.
#   AUDIO_KNOB_INVERT   1: the knob's dial counts counter-clockwise as up.
#                       Default 0.
#
# The API is on /run/f250-audio/audio.sock (RuntimeDirectory); the driver's
# speaker settings in /var/lib/f250-audio/speakers.json, the volume in
# volume.json and the phone connected last in last-phone (StateDirectory).
#
# Status: [SIM] (make agl-test).
set -euo pipefail

BIN="${F250_AUDIO_BIN:-/opt/f250/bin/audio-manager}"
SOCK="${F250_AUDIO_SOCK:-/run/f250-audio/audio.sock}"
RUN="${F250_AUDIO_RUN:-/run/f250-audio}"
STATE="${F250_AUDIO_STATE:-/var/lib/f250-audio}"

args=(--listen "unix:$SOCK" --settings-file "$STATE/speakers.json" --dsp-conf "$RUN/speakers.conf" --last-phone-file "$STATE/last-phone" --volume-file "$STATE/volume.json")
if [[ "${AUDIO_SIMULATE:-0}" == 1 ]]; then
  args+=(--simulate)
fi
[[ -n "${AUDIO_ADAPTER:-}" ]] && args+=(--adapter "$AUDIO_ADAPTER")
[[ -n "${AUDIO_NAME:-}" ]] && args+=(--name "$AUDIO_NAME")
[[ -n "${AUDIO_PAIR_WINDOW_S:-}" ]] && args+=(--pair-window-s "$AUDIO_PAIR_WINDOW_S")
case "${AUDIO_DSP:-1}" in
  1) ;;
  0) args+=(--no-dsp) ;;
  *) echo "audio-start: AUDIO_DSP=$AUDIO_DSP: use 0 or 1" >&2; exit 2 ;;
esac
[[ -n "${AUDIO_DAC_NODE:-}" ]] && args+=(--dac-node "$AUDIO_DAC_NODE")
[[ -n "${AUDIO_DAC_POSITIONS:-}" ]] && args+=(--dac-positions "$AUDIO_DAC_POSITIONS")
[[ -n "${AUDIO_FRONT:-}" ]] && args+=(--front "$AUDIO_FRONT")
[[ -n "${AUDIO_REAR:-}" ]] && args+=(--rear "$AUDIO_REAR")
[[ -n "${AUDIO_SUB:-}" ]] && args+=(--sub "$AUDIO_SUB")
[[ -n "${AUDIO_CROSSOVER_HZ:-}" ]] && args+=(--crossover-hz "$AUDIO_CROSSOVER_HZ")
case "${AUDIO_VOICE:-}" in
  none) ;;
  "") args+=(--voice-command /opt/f250/libexec/speak-prompt) ;;
  *) args+=(--voice-command "$AUDIO_VOICE") ;;
esac
[[ -n "${AUDIO_PROMPT_HOLD_MS:-}" ]] && args+=(--prompt-hold-ms "$AUDIO_PROMPT_HOLD_MS")
[[ -n "${AUDIO_RECONNECT_EVERY_S:-}" ]] && args+=(--reconnect-every-s "$AUDIO_RECONNECT_EVERY_S")
[[ -n "${AUDIO_RECONNECT_FOR_S:-}" ]] && args+=(--reconnect-for-s "$AUDIO_RECONNECT_FOR_S")
case "${AUDIO_COVER_ART:-1}" in
  1) [[ "${AUDIO_SIMULATE:-0}" == 1 ]] || args+=(--cover-art-file "${F250_OBEX_RUN:-/run/f250-obex}/cover-art") ;;
  0) ;;
  *) echo "audio-start: AUDIO_COVER_ART=$AUDIO_COVER_ART: use 0 or 1" >&2; exit 2 ;;
esac
# The phone's contacts and recent calls over PBAP (ADR-0045 phase 2): obexd
# writes each list on tmpfs, audio-manager reads and removes it at once.
case "${AUDIO_PHONEBOOK:-1}" in
  1) [[ "${AUDIO_SIMULATE:-0}" == 1 ]] || args+=(--phonebook-file "${F250_OBEX_RUN:-/run/f250-obex}/phonebook.vcf") ;;
  0) ;;
  *) echo "audio-start: AUDIO_PHONEBOOK=$AUDIO_PHONEBOOK: use 0 or 1" >&2; exit 2 ;;
esac

[[ -n "${AUDIO_VOLUME_STEPS:-}" ]] && args+=(--volume-steps "$AUDIO_VOLUME_STEPS")
[[ -n "${AUDIO_VOLUME_STEP_DB:-}" ]] && args+=(--volume-step-db "$AUDIO_VOLUME_STEP_DB")
[[ -n "${AUDIO_VOLUME_MAX:-}" ]] && args+=(--volume-max "$AUDIO_VOLUME_MAX")
[[ -n "${AUDIO_VOLUME_START_MAX:-}" ]] && args+=(--volume-start-max "$AUDIO_VOLUME_START_MAX")
case "${AUDIO_KNOB:-1}" in
  1) args+=(--knob) ;;
  0) ;;
  *) echo "audio-start: AUDIO_KNOB=$AUDIO_KNOB: use 0 or 1" >&2; exit 2 ;;
esac
case "${AUDIO_KNOB_INVERT:-0}" in
  1) args+=(--knob-invert) ;;
  0) ;;
  *) echo "audio-start: AUDIO_KNOB_INVERT=$AUDIO_KNOB_INVERT: use 0 or 1" >&2; exit 2 ;;
esac

echo "exec $BIN ${args[*]}" >&2
exec "$BIN" "${args[@]}"
