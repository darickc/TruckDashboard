#!/bin/bash
# Says its argument through the speakers: audio-manager's voice for spoken
# directions (ADR-0039 decision 9, ADR-0048). The WAV comes from Piper
# through f250-tts.service (`tts say`, the voice kept loaded) when its socket
# is there, else from Flite+hts_engine 1.06 (meta-agl-demo's flite, voice
# flite-voicedata: cmu_us_arctic_slt), in audio-manager's runtime directory;
# pw-play plays it with media.role Speech-High, which AGL's role policy gives
# "cork" over Multimedia: the music is silenced at once while it plays.
#
# audio-manager kills this to cut a prompt off, so the last step is an exec
# (the kill reaches pw-play). Older prompts' files are removed first.
#
#   F250_TTS_SOCK   default /run/f250-tts/tts.sock (Piper; absent: Flite)
#   F250_TTS_CLIENT default /opt/f250/bin/tts (`tts say`)
#   F250_TTS        default flite_hts_engine (text on stdin, -m voice, -o wav)
#   F250_TTS_VOICE  default /usr/share/Voice/us/cmu_us_arctic_slt.htsvoice
#   F250_PLAY       default pw-play (PipeWire's pw-cat)
#   F250_AUDIO_RUN  default /run/f250-audio
#
# Status: [SIM] (make agl-test, with stand-ins); Piper's path [BENCH]
# 2026-11-15 (ADR-0048).
set -euo pipefail

TEXT="${1:?usage: speak-prompt TEXT}"
SOCK="${F250_TTS_SOCK:-/run/f250-tts/tts.sock}"
CLIENT="${F250_TTS_CLIENT:-/opt/f250/bin/tts}"
TTS="${F250_TTS:-flite_hts_engine}"
VOICE="${F250_TTS_VOICE:-/usr/share/Voice/us/cmu_us_arctic_slt.htsvoice}"
PLAY="${F250_PLAY:-pw-play}"
DIR="${F250_AUDIO_RUN:-/run/f250-audio}"

mkdir -p "$DIR"
rm -f "$DIR"/prompt-*.wav "$DIR"/prompt-*.wav.part
WAV="$DIR/prompt-$$.wav"
# Piper when its service is up; Flite when it isn't, or when it fails (the
# reason is in the client's message and f250-tts's log).
if [[ -S "$SOCK" ]] && "$CLIENT" say --socket "$SOCK" --out "$WAV" "$TEXT"; then
  :
else
  [[ -S "$SOCK" ]] && echo "speak-prompt: Piper failed; Flite instead" >&2
  printf '%s\n' "$TEXT" | "$TTS" -m "$VOICE" -o "$WAV"
fi
exec "$PLAY" --media-role Speech-High "$WAV"
