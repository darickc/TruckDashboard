#!/bin/bash
# ExecStart of f250-camera-manager.service on AGL: camera-manager with the
# cameras from /etc/default/f250.
#
#   CAMERA_LEFT, CAMERA_RIGHT, CAMERA_REAR   V4L2 device of each camera, e.g.
#       /dev/v4l/by-id/usb-...-video-index0 (stable across reboots, unlike
#       /dev/videoN). Empty: that camera shows as unavailable when chosen.
#   CAMERA_CAPS   caps and decoder after v4l2src; empty: camera-manager's
#       default (the bench webcam's 640x480 MJPEG, ADR-0026).
#
# Status: [SIM] (make agl-test). Not yet run on the Pi.
set -euo pipefail

SOCK="${F250_CAMERA_SOCK:-/run/f250-camera/camera.sock}"
BIN="${F250_CAMERA_BIN:-/opt/f250/bin/camera-manager}"

args=(--listen "unix:$SOCK")
for pair in left:CAMERA_LEFT right:CAMERA_RIGHT rear:CAMERA_REAR; do
  name="${pair%%:*}"
  var="${pair#*:}"
  dev="${!var:-}"
  if [[ -n "$dev" ]]; then
    [[ "$dev" == *[[:space:]]* ]] && { echo "$var has a space in it: $dev" >&2; exit 1; }
    args+=(--camera "$name=$dev")
  fi
done
if [[ -n "${CAMERA_CAPS:-}" ]]; then
  args+=(--caps "$CAMERA_CAPS")
fi

echo "exec $BIN ${args[*]}" >&2
exec "$BIN" "${args[@]}"
