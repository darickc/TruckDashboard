#!/bin/bash
# ExecStart of f250-echo-cancel.service: echo cancellation for phone calls
# (ADR-0045 decision 3, spike S3). Writes a PipeWire client configuration
# from /etc/default/f250 and runs `pipewire -c` with it, a client of the
# system PipeWire holding only PipeWire's echo-cancel module with the WebRTC
# canceller (libspa-aec-webrtc, which meta-f250 adds to the image).
#
#   AUDIO_CALL_MIC          the call microphone (a source's node.name). Empty:
#                           calls are off, and so is this (exits 0).
#   AUDIO_CALL_ECHO_CANCEL  1 (or empty): on. 0: off (exits 0), and
#                           audio-start gives the phone the microphone itself.
#   AUDIO_DAC_NODE          the echo's reference is this sink's monitor, what
#                           the speakers play; empty: the default sink's.
#
# The module, in monitor mode (PipeWire 1.6.8 module-echo-cancel.c):
#   - f250.call-aec.mic        captures AUDIO_CALL_MIC (passive: the
#                              microphone runs only while a call takes the
#                              source)
#   - f250.call-aec.reference  captures the sink's monitor ports, everything
#                              the speakers play (the caller, a ring tone)
#   - f250.call-aec            the source the phone gets: the microphone with
#                              the speakers' echo removed. audio-start passes
#                              it to audio-manager as --call-mic.
# Mono at 48 kHz: the call is mono (mSBC 16 kHz, CVSD 8 kHz); PipeWire
# converts both sides. The WebRTC options are the module's defaults (high-pass
# filter and noise suppression on, gain control off).
#
# F250_PIPEWIRE, F250_AEC_CONF and F250_AEC_PLUGIN are for the tests.
#
# Status: [SIM] (make agl-test). UNVERIFIED on the Pi: that WirePlumber
# links the reference to the DAC's monitor under AGL's policy, the far end's
# echo at a normal volume, and the CPU it costs (S3).
set -euo pipefail

PIPEWIRE="${F250_PIPEWIRE:-/usr/bin/pipewire}"
CONF="${F250_AEC_CONF:-/run/f250-echo-cancel/echo-cancel.conf}"
PLUGIN="${F250_AEC_PLUGIN:-/usr/lib/spa-0.2/aec/libspa-aec-webrtc.so}"

mic="${AUDIO_CALL_MIC:-}"
mic="${mic//[[:space:]]/}"
dac="${AUDIO_DAC_NODE:-}"
dac="${dac//[[:space:]]/}"

if [[ -z "$mic" ]]; then
  echo "echo-cancel: off (no AUDIO_CALL_MIC: calls stay on the phone)"
  exit 0
fi
case "${AUDIO_CALL_ECHO_CANCEL:-1}" in
  1) ;;
  0) echo "echo-cancel: off (AUDIO_CALL_ECHO_CANCEL=0): the phone gets $mic as it is"; exit 0 ;;
  *) echo "echo-cancel: AUDIO_CALL_ECHO_CANCEL=$AUDIO_CALL_ECHO_CANCEL: use 0 or 1" >&2; exit 2 ;;
esac
# Node names go into the configuration quoted: nothing that ends a string.
for v in "$mic" "$dac"; do
  if [[ "$v" == *[\"\\]* ]]; then
    echo "echo-cancel: node name $v: no quotes or backslashes" >&2
    exit 2
  fi
done
if [[ ! -e "$PLUGIN" ]]; then
  echo "echo-cancel: $PLUGIN missing: this image has no WebRTC canceller (meta-f250's pipewire bbappend)" >&2
  exit 1
fi

if [[ -n "$dac" ]]; then
  reference="                target.object = \"$dac\""
else
  reference="                # No AUDIO_DAC_NODE: the default sink's monitor."
fi

mkdir -p "$(dirname "$CONF")"
cat >"$CONF.new" <<EOF
# Generated by /opt/f250/libexec/echo-cancel-start from /etc/default/f250
# (ADR-0045): do not edit.
context.properties = {
    log.level = 0
}
context.spa-libs = {
    audio.convert.* = audioconvert/libspa-audioconvert
    support.*       = support/libspa-support
}
context.modules = [
    { name = libpipewire-module-rt args = { } flags = [ ifexists nofail ] }
    { name = libpipewire-module-protocol-native }
    { name = libpipewire-module-client-node }
    { name = libpipewire-module-adapter }
    { name = libpipewire-module-echo-cancel
        args = {
            library.name   = aec/libspa-aec-webrtc
            monitor.mode   = true
            audio.rate     = 48000
            audio.channels = 1
            audio.position = [ MONO ]
            capture.props = {
                node.name        = "f250.call-aec.mic"
                node.description = "F-250 call microphone (raw)"
                target.object    = "$mic"
            }
            source.props = {
                node.name        = "f250.call-aec"
                node.description = "F-250 call microphone (echo cancelled)"
            }
            sink.props = {
                node.name        = "f250.call-aec.reference"
                node.description = "F-250 call echo reference"
$reference
            }
        }
    }
]
EOF
mv "$CONF.new" "$CONF"

echo "echo-cancel: WebRTC on $mic, reference ${dac:-the default sink}; the phone gets f250.call-aec"
exec "$PIPEWIRE" -c "$CONF"
