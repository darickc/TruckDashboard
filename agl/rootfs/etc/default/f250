# F-250 head unit settings for the AGL services (f250-gateway, f250-recorder,
# f250-dashboard, f250-power-manager). The same options as `make pi-run` (tools/pi/run.sh).
# After editing: systemctl restart f250-gateway
#
# TRANSPORT  sim | obdlink | can
# TRANSMIT   0 | 1. 1 is the ADR-0007 opt-in: read-only polling. Without it
#            the gateway never opens the adapter (PASSIVE_ONLY).
#            With TRANSPORT=can, can0 must also be in active mode first
#            (tools/pi/can.sh active), only after the wiring checklist.
TRANSPORT=sim
TRANSMIT=0
ADAPTER=rfcomm:00:04:3E:85:EA:FC
CAN_IF=can0
# PINNED     can only. physical (empty: the default): EOT goes to 7E0 and trans
#            temp to 7E1, so the other module never hears them. functional:
#            both on 7DF, as on the 2026-11-08 drive (the fallback).
PINNED=
# Comma-separated signal ids to enable, and the request budget (empty: defaults)
ENABLE=
BUDGET_RPS=
# Simulator only
SCENARIO=drive_cycle
START=0
# DATA_DRIVE 0 | 1. 1: an ext4 drive labelled f250-data (an NVMe HAT, or a
#            USB SSD) mounts at /var/lib/f250/storage and holds the telemetry
#            database and traffic logs. Format it once with f250-storage, then
#            rerun /opt/f250/share/agl/scripts/stage1-setup.sh. With 1 and no
#            drive, the recorder stops rather than write to the SD card.
DATA_DRIVE=0
# BOOT_KEY_IGNORE_S  power-manager: seconds after boot in which the power key
#            is ignored (the DCDC-USB's ON pulse). An example value: tune it
#            once H21 measures the ON pulse; keep it shorter than the
#            supply's OFFDELAY. After editing: systemctl restart f250-power-manager
BOOT_KEY_IGNORE_S=30
# CAMERA_MANAGER  power-manager: where camera-switch moves go (camera-manager's
#            f250.camera.v1 API). Default unix:/run/f250-camera/camera.sock,
#            set in the unit. Set it empty to only log the moves.
# CAMERA_FRONT, CAMERA_LEFT, CAMERA_RIGHT, CAMERA_REAR  camera-manager: each
#            camera's V4L2 device. Use /dev/v4l/by-path/...-video-index0
#            (ls -l /dev/v4l/by-path): it names the USB port, so a camera's
#            role follows the port it is plugged into, and identical cameras
#            (which share a by-id name) stay apart. Not /dev/videoN, which
#            can change between boots. Empty: the camera shows as unavailable
#            when chosen. The switch: forward front, left, right, back rear,
#            press closes. The bench webcam (a stand-in, not a truck camera)
#            was /dev/video0 (bench-log 2026-11-09).
#            After editing: systemctl restart f250-camera-manager
CAMERA_FRONT=
CAMERA_LEFT=
CAMERA_RIGHT=
CAMERA_REAR=
# CAMERA_CAPS  camera-manager: caps and decoder after v4l2src. Empty: the
#            bench webcam's 640x480 MJPEG (ADR-0026).
CAMERA_CAPS=
# CAMERA_MEDIA  camera-manager: gstreamer (in-process; records) or launch
#            (a gst-launch-1.0 child for the camera on screen; never records:
#            the display path bench-tested on 2026-11-10). Empty: gstreamer
#            when camera-manager was built with it (make deploy), else launch.
CAMERA_MEDIA=
# RECORD_CAMERAS  camera-manager: front and rear record like a dashcam
#            (ADR-0027), only those with a device above, and only with
#            DATA_DRIVE=1: video never goes to the SD card. Empty: no
#            recording. Recordings: /var/lib/f250/storage/video.
RECORD_CAMERAS=front,rear
# Retention (ADR-0027 decision 7). Examples: the recommendations for a
#            512 GB drive; for 1 TB, RECORD_MAX_GB=550, RECORD_MIN_FREE_GB=100,
#            RECORD_PROTECTED_MAX_GB=50. Set them for the drive that is fitted
#            (H31). Empty: the 512 GB recommendation.
#   RECORD_MAX_AGE_DAYS      delete segments older than this (only judged on
#                            an NTP-synchronized clock); 0: no age limit
#   RECORD_MAX_GB            front and rear video together
#   RECORD_MIN_FREE_GB       always this much free on the drive
#   RECORD_PROTECTED_MAX_GB  saved clips; a save that doesn't fit is refused
#   RECORD_MAX_SEGMENTS      per camera; 0: off
#   RECORD_SEGMENT_S         segment length
#   RECORD_SYNC_S            the segment being written goes to the drive this often
#   RECORD_UNCLEAN_PROTECT_MIN  minutes protected before an unclean stop; 0: off
#   RECORD_CLIP_BEFORE_S, RECORD_CLIP_AFTER_S  what "Save clip" keeps
#            After editing: systemctl restart f250-camera-manager
RECORD_MAX_AGE_DAYS=14
RECORD_MAX_GB=250
RECORD_MIN_FREE_GB=50
RECORD_PROTECTED_MAX_GB=25
RECORD_MAX_SEGMENTS=0
RECORD_SEGMENT_S=60
RECORD_SYNC_S=1
RECORD_UNCLEAN_PROTECT_MIN=5
RECORD_CLIP_BEFORE_S=120
RECORD_CLIP_AFTER_S=60
