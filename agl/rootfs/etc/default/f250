# F-250 head unit settings for the AGL services (f250-gateway, f250-recorder,
# f250-dashboard, f250-power-manager). The same options as `make pi-run` (tools/pi/run.sh).
# After editing: systemctl restart f250-gateway
#
# TRANSPORT  sim | obdlink | can
# TRANSMIT   0 | 1. 1 is the ADR-0007 opt-in: read-only polling. Without it
#            the gateway never opens the adapter (PASSIVE_ONLY).
#            With TRANSPORT=can, can0 must also be in active mode first
#            (tools/pi/can.sh active), only after the wiring checklist.
TRANSPORT=sim
TRANSMIT=0
ADAPTER=rfcomm:00:04:3E:85:EA:FC
CAN_IF=can0
# CAN_AUTO_ACTIVE  0 | 1. 1: at boot, f250-can-auto puts can0 in listen-only
#            mode and switches it to active only after hearing the truck's
#            bus cleanly (CAN_AUTO_MIN_FRAMES frames, 1000, in CAN_AUTO_LISTEN_S, 3 s, no
#            errors), then restarts the gateway; no laptop needed. 0: can0
#            stays down until `f250-can listen|active` by hand (ADR-0007
#            decision 1, amended 2026-11-10). Needs TRANSMIT=1 to poll, and the
#            wiring checklist signed off.
# CAN_AUTO_CAPTURE  1: once active, also capture every frame until shutdown,
#            into /var/lib/f250/captures (SD card, ~270 MB an hour, bounded
#            by the CAPTURE_* settings below)
# CAPTURE_PART_MB, CAPTURE_MAX_MB, CAPTURE_MIN_FREE_MB  every capture's
#            bounds (f250-can capture): parts of 64 MB, 2048 MB in all (the
#            oldest part is deleted first, listed in the capture's
#            pruned.txt), and the capture stops below 1024 MB free. Empty:
#            those defaults, examples to tune for the card.
CAN_AUTO_ACTIVE=0
CAN_AUTO_CAPTURE=0
CAPTURE_PART_MB=
CAPTURE_MAX_MB=
CAPTURE_MIN_FREE_MB=
CAN_AUTO_LISTEN_S=
CAN_AUTO_MIN_FRAMES=
# PINNED     can only. physical (empty: the default): EOT goes to 7E0 and trans
#            temp to 7E1, so the other module never hears them. functional:
#            both on 7DF, as on the 2026-11-08 drive (the fallback).
PINNED=
# Comma-separated signal ids to enable, and the request budget (empty: defaults)
ENABLE=
BUDGET_RPS=
# Simulator only
SCENARIO=drive_cycle
START=0
# DATA_DRIVE 0 | 1. 1: an ext4 drive labelled f250-data (an NVMe HAT, or a
#            USB SSD) mounts at /var/lib/f250/storage and holds the telemetry
#            database and traffic logs. Format it once with f250-storage, then
#            rerun /opt/f250/share/agl/scripts/stage1-setup.sh. With 1 and no
#            drive, the recorder stops rather than write to the SD card.
DATA_DRIVE=0
# BOOT_KEY_IGNORE_S  power-manager: seconds after boot in which the power key
#            is ignored (the DCDC-USB's ON pulse). An example value: tune it
#            once H21 measures the ON pulse; keep it shorter than the
#            supply's OFFDELAY. After editing: systemctl restart f250-power-manager
BOOT_KEY_IGNORE_S=30
# Day/night and the backlight (power-manager, ADR-0028). Every value is an
#            example to tune. After editing: systemctl restart f250-power-manager
# DISPLAY_LATITUDE, DISPLAY_LONGITUDE  where the truck is, in degrees (north
#            and east positive; the United States has a negative longitude),
#            for the sun's elevation. Two decimals is plenty. Only until
#            there is a GPS position: a fix through navigation replaces them,
#            and the last one is kept (to 0.1°) in
#            /var/lib/f250-power/location for the next start (ADR-0028
#            amendment). With neither, Auto shows DISPLAY_FALLBACK, saying why.
# DISPLAY_NAVIGATION  where power-manager reads the GPS position, and the GPS
#            time while the clock isn't synchronized (navigation's
#            f250.nav.v1 API). Default unix:/run/f250-nav/nav.sock, set in
#            the unit. Set it empty to use only DISPLAY_LATITUDE/LONGITUDE.
# DISPLAY_NIGHT_BELOW_DEG  night once the sun is below this (empty: -3)
# DISPLAY_HYSTERESIS_DEG   day again this far above it (empty: 1)
# DISPLAY_FALLBACK         day | night: when Auto can't follow the sun (empty:
#            day, so an alert is never too dim to read in daylight)
# DISPLAY_TRUST_CLOCK      synchronized | always. synchronized (empty): the sun
#            only while the system reports the clock synchronized (network
#            time) or, failing that, from a current GPS fix's time. always:
#            trust it anyway, once the RTC cell holds the time across a parked
#            night (H20). A clock before 2026 is never trusted.
# DISPLAY_MIN_BRIGHTNESS_PCT  the backlight never goes below this (empty: 10)
# DISPLAY_BACKLIGHT        the device under /sys/class/backlight (empty: the
#            first; 10-0045 on the bench Pi), or none
DISPLAY_LATITUDE=
DISPLAY_LONGITUDE=
DISPLAY_NIGHT_BELOW_DEG=
DISPLAY_HYSTERESIS_DEG=
DISPLAY_FALLBACK=
DISPLAY_TRUST_CLOCK=
DISPLAY_MIN_BRIGHTNESS_PCT=
DISPLAY_BACKLIGHT=
# CAMERA_MANAGER  power-manager: where camera-switch moves go (camera-manager's
#            f250.camera.v1 API). Default unix:/run/f250-camera/camera.sock,
#            set in the unit. Set it empty to only log the moves.
# CAMERA_FRONT, CAMERA_LEFT, CAMERA_RIGHT, CAMERA_REAR  camera-manager: each
#            camera's V4L2 device. The dashboard's Settings tab sets these too
#            (ADR-0029): once saved there, /var/lib/f250-camera/settings
#            replaces them and RECORD_CAMERAS; its "Use /etc/default/f250"
#            brings these back. `camera-ctl settings` shows which applies. Use /dev/v4l/by-path/...-video-index0
#            (ls -l /dev/v4l/by-path): it names the USB port, so a camera's
#            role follows the port it is plugged into, and identical cameras
#            (which share a by-id name) stay apart. Not /dev/videoN, which
#            can change between boots. Empty: the camera shows as unavailable
#            when chosen. The switch: forward front, left, right, back rear,
#            press closes. The bench webcam (a stand-in, not a truck camera)
#            was /dev/video0 (bench-log 2026-11-09).
#            After editing: systemctl restart f250-camera-manager
CAMERA_FRONT=
CAMERA_LEFT=
CAMERA_RIGHT=
CAMERA_REAR=
# CAMERA_AUTO_REVERSE  1: reverse shows the rear camera by itself, from
#            the gateway's receive-only reader of the broadcast 230
#            (ADR-0046; reverse verified on the truck 2026-11-10). 0: off,
#            the switch's back or the dashboard's Rear only. Empty: on with
#            TRANSPORT=can, off otherwise (no broadcast to hear).
# CAMERA_REVERSE_DEBOUNCE_MS, CAMERA_REVERSE_HOLD_MS  examples: reverse must
#            last this long before the rear view comes up (empty: 300), and
#            the view stays this long after (empty: 2000).
#            After editing: systemctl restart f250-camera-manager
CAMERA_AUTO_REVERSE=
CAMERA_REVERSE_DEBOUNCE_MS=
CAMERA_REVERSE_HOLD_MS=
# CAMERA_CAPS  camera-manager: caps and decoder after v4l2src. Empty: the
#            bench webcam's 640x480 MJPEG (ADR-0026).
CAMERA_CAPS=
# CAMERA_MEDIA  camera-manager: gstreamer (in-process; records) or launch
#            (a gst-launch-1.0 child for the camera on screen; never records:
#            the display path bench-tested on 2026-11-10). Empty: gstreamer
#            when camera-manager was built with it (make deploy), else launch.
CAMERA_MEDIA=
# RECORD_CAMERAS  camera-manager: front and rear record like a dashcam
#            (ADR-0027), only those with a device above, and only with
#            DATA_DRIVE=1: video never goes to the SD card. Empty: no
#            recording. Recordings: /var/lib/f250/storage/video.
RECORD_CAMERAS=front,rear
# Retention (ADR-0027 decision 7). Examples: the recommendations for a
#            512 GB drive; for 1 TB, RECORD_MAX_GB=550, RECORD_MIN_FREE_GB=100,
#            RECORD_PROTECTED_MAX_GB=50. Set them for the drive that is fitted
#            (H31). Empty: the 512 GB recommendation.
#   RECORD_MAX_AGE_DAYS      delete segments older than this (only judged on
#                            an NTP-synchronized clock); 0: no age limit
#   RECORD_MAX_GB            front and rear video together
#   RECORD_MIN_FREE_GB       always this much free on the drive
#   RECORD_PROTECTED_MAX_GB  saved clips; a save that doesn't fit is refused
#   RECORD_MAX_SEGMENTS      per camera; 0: off
#   RECORD_SEGMENT_S         segment length
#   RECORD_SYNC_S            the segment being written goes to the drive this often
#   RECORD_UNCLEAN_PROTECT_MIN  minutes protected before an unclean stop; 0: off
#   RECORD_CLIP_BEFORE_S, RECORD_CLIP_AFTER_S  what "Save clip" keeps
#            After editing: systemctl restart f250-camera-manager
RECORD_MAX_AGE_DAYS=14
RECORD_MAX_GB=250
RECORD_MIN_FREE_GB=50
RECORD_PROTECTED_MAX_GB=25
RECORD_MAX_SEGMENTS=0
RECORD_SEGMENT_S=60
RECORD_SYNC_S=1
RECORD_UNCLEAN_PROTECT_MIN=5
RECORD_CLIP_BEFORE_S=120
RECORD_CLIP_AFTER_S=60
# Navigation (Phase 6.4, ADR-0030). After editing: systemctl restart f250-navigation
# NAV_GPSD     gpsd's address (empty: 127.0.0.1:2947). gpsd owns the receiver.
# NAV_SIMULATE 1: a simulated receiver instead of gpsd, labelled simulated on
#            the screen (bench without a receiver). 0: gpsd.
# NAV_STALE_AFTER_MS  a fix older than this is never shown as current (empty:
#            3000, an example: tune it once a receiver is fitted, H11).
# The offline map is /var/lib/f250/storage/maps/map.pmtiles, on the data
#            drive: a vector or raster PMTiles file the dashboard reads. A map
#            stick (make map-stick) updates it (ADR-0033, docs/setup/maps.md). Without it the screen
#            says so and still shows the position.
# Routing (6.5.2, ADR-0035), with Valhalla. NOT checked for heavy vehicles or
#            trailers (ADR-0010).
# NAV_VALHALLA  valhalla_service (empty: on PATH; the image has it in
#            /usr/bin, recipes-navigation/valhalla).
# NAV_ROUTING_TILES  the routing data (empty: /var/lib/f250/storage/routing/
#            valhalla_tiles.tar), built with make route-region and brought
#            on the map stick (make map-stick ROUTING=...). Without it the
#            Nav screen says routing is unavailable.
# NAV_COSTING  auto (empty: auto) or truck. With truck, NAV_TRUCK_HEIGHT_M,
#            _WIDTH_M, _LENGTH_M (metres), _WEIGHT_T, _AXLE_LOAD_T (tonnes);
#            each empty: Valhalla's default, which is a large truck's.
# Address search (6.5.3, ADR-0038), offline.
# NAV_SEARCH_INDEX  the search data (empty: /var/lib/f250/storage/search/
#            search.sqlite), brought by the map stick (make map-stick
#            SEARCH=...). Without it the search panel says why.
# Saved places and spoken directions (6.5.2, ADR-0040). Places are kept in
#            /var/lib/f250/storage/navigation/ (with DATA_DRIVE=1 and no drive
#            mounted, /var/lib/f250-nav/; the Nav screen says which).
# NAV_AUDIO_MANAGER  audio-manager's API: it says the prompts and pauses the
#            music while they are spoken (ADR-0039, ADR-0040). Empty: prompts
#            go to the journal only.
# NAV_VOICE_COMMAND  for development only: a program that speaks its last
#            argument, used instead of audio-manager. Not audible under the
#            service's sandbox (no sound devices).
# NAV_VOICE_UNITS  imperial (empty: imperial) or metric, for spoken distances.
NAV_GPSD=
NAV_SIMULATE=0
NAV_STALE_AFTER_MS=
NAV_VALHALLA=
NAV_ROUTING_TILES=
NAV_SEARCH_INDEX=
NAV_AUDIO_MANAGER=unix:/run/f250-audio/audio.sock
NAV_VOICE_COMMAND=
NAV_VOICE_UNITS=imperial
NAV_COSTING=auto
NAV_TRUCK_HEIGHT_M=
NAV_TRUCK_WIDTH_M=
NAV_TRUCK_LENGTH_M=
NAV_TRUCK_WEIGHT_T=
NAV_TRUCK_AXLE_LOAD_T=
# Bluetooth audio and the speakers (Phase 6.1, ADR-0039). After editing:
# systemctl restart f250-audio-manager
# AUDIO_SIMULATE 1: a simulated phone and no filter-chain, labelled simulated
#            on the screen (bench without a phone). 0: BlueZ and PipeWire.
# AUDIO_ADAPTER  the Bluetooth adapter (empty: hci0).
# AUDIO_NAME     the name phones see while pairing (empty: F-250).
# AUDIO_PAIR_WINDOW_S  the pairing window's length in seconds (empty: 120,
#            an example). It opens only from the Media screen and closes by
#            itself, and when one phone has paired.
# AUDIO_DSP      0: no filter-chain (no crossover, fader or sub). 1: on.
# The filter-chain in front of the HiFiBerry DAC8x (ADR-0014). UNVERIFIED
# until the bench: the DAC's node name and which channel is which jack
# (docs/wiring/audio.md, a test tone per jack).
# AUDIO_DAC_NODE  the DAC's PipeWire node name (pw-cli ls Node; empty: the
#            default sink).
# AUDIO_DAC_POSITIONS  its channel positions in order (empty:
#            FL,FR,RL,RR,FC,LFE,SL,SR).
# AUDIO_FRONT, AUDIO_REAR, AUDIO_SUB  the DAC channels (0-based left,right)
#            of jacks 1, 2 and 3 (empty: 0,1 / 2,3 / 4,5, examples). The sub
#            gets (L+R)/2 on both, low-passed.
# AUDIO_CROSSOVER_HZ  the crossover's default (empty: 80 Hz, an example; tune
#            it in the truck). The driver changes it, the fader, balance and
#            sub level under Settings → Speakers.
AUDIO_SIMULATE=0
AUDIO_ADAPTER=
AUDIO_NAME=
AUDIO_PAIR_WINDOW_S=
AUDIO_DSP=1
AUDIO_DAC_NODE=
AUDIO_DAC_POSITIONS=
AUDIO_FRONT=
AUDIO_REAR=
AUDIO_SUB=
AUDIO_CROSSOVER_HZ=
# AUDIO_COVER_ART  1 (or empty): the playing track's picture on the Media
#            screen, fetched from the phone through obexd (ADR-0042). 0: none.
AUDIO_COVER_ART=
# AUDIO_PHONEBOOK  1 (or empty): the connected phone's contacts and recent
#            calls on the Phone screen, read over Bluetooth (PBAP) through
#            obexd when it connects; kept in memory only (ADR-0045 phase
#            2). The phone may ask to allow it. 0: not read.
AUDIO_PHONEBOOK=
# Phone calls through the truck (ADR-0045). Off unless AUDIO_CALL_MIC is
# set: then phones see a hands-free unit (f250-calls-config) and route calls
# to the head unit while connected. After changing it:
#   systemctl restart f250-calls-config f250-audio-manager
# AUDIO_CALL_MIC  the call microphone, a PipeWire source's node.name
#            (`wpctl status`, then `pw-cli info <id>`). Empty: calls stay on
#            the phone. No echo cancellation yet (ADR-0045 spike S3).
# AUDIO_CALL_SPEAKER  where the caller's voice goes, a PipeWire sink's
#            node.name (empty: the default sink).
# AUDIO_RING_COMMAND  plays the ring tone for a phone that doesn't ring
#            in-band (empty: /usr/bin/pw-play; none: no tone).
AUDIO_CALL_MIC=
AUDIO_CALL_SPEAKER=
AUDIO_RING_COMMAND=
# Spoken directions (ADR-0039 decision 9; navigation, ADR-0040). The music
# is paused while a prompt is said (owner, 2026-11-12) and resumed after.
# AUDIO_VOICE  a program that says its argument (empty:
#            /opt/f250/libexec/speak-prompt, Flite); none: no prompts.
# AUDIO_PROMPT_HOLD_MS  the music resumes this long after the last prompt
#            (empty: 1000, an example), so close prompts don't let it back in.
AUDIO_VOICE=
AUDIO_PROMPT_HOLD_MS=
# Phones (the Media screen's Phones): with none connected, audio-manager tries
# the phone connected last (kept in /var/lib/f250-audio/last-phone) by itself
# after start, Bluetooth coming back or the link dropping.
# AUDIO_RECONNECT_EVERY_S  between attempts (empty: 20, an example).
# AUDIO_RECONNECT_FOR_S  for this long (empty: 300, an example); 0: never.
AUDIO_RECONNECT_EVERY_S=
AUDIO_RECONNECT_FOR_S=
# The master volume (ADR-0043). Examples, not recommendations (empty: the
# defaults in brackets).
# AUDIO_VOLUME_STEPS  steps, the top one 0 dB (30).
# AUDIO_VOLUME_STEP_DB  dB a step (2).
# AUDIO_VOLUME_MAX  the highest level the driver may set (the top step):
#                lower it for speakers that can't take the amps' full output.
# AUDIO_VOLUME_START_MAX  starts no louder than this, whatever was saved (15).
AUDIO_VOLUME_STEPS=
AUDIO_VOLUME_STEP_DB=
AUDIO_VOLUME_MAX=
AUDIO_VOLUME_START_MAX=
# AUDIO_KNOB  1 (or empty): the volume knob from /dev/input, any device with
#             the volume keys, play/pause or a dial (REL_DIAL). 0: none.
#             Which knob: TODO.
# AUDIO_KNOB_INVERT  1: the dial counts counter-clockwise as up.
AUDIO_KNOB=
AUDIO_KNOB_INVERT=

# The knob display (ADR-0044): knob-link feeds it from the gateway.
# KNOB_UNITS   imperial (or empty) or metric.
# KNOB_DEVICE  its serial port (empty: found by its USB name, F-250 knob).
KNOB_UNITS=
KNOB_DEVICE=
