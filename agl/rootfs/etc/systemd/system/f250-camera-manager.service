# Camera manager on AGL (Phase 6.6, ADR-0009, ADR-0026). Shows the camera the
# policy picks as a gst-launch-1.0 pipeline whose waylandsink window
# agl-compositor confines to the dashboard's activation area (y 96-416 in
# agl/flutter/config.toml), below the status bar and the alert banner. Serves
# f250.camera.v1 on /run/f250-camera/camera.sock; power-manager sends the
# camera switch's moves there. Cameras: CAMERA_LEFT, CAMERA_RIGHT and
# CAMERA_REAR in /etc/default/f250 (camera-start). A camera with no device
# shows as unavailable when chosen.
#
# User agl-driver, as the dashboard: the windows need the compositor's
# Wayland socket in /run/user/1001, which only agl-driver can reach. Group
# f250, so the API socket (group f250, mode 0770 from UMask) is open to
# power-manager. /run/f250 is the gateway's and only f250 writes there, so
# this socket has a directory of its own. `video` for /dev/video*.
#
# Not bound to the compositor: a compositor restart ends the running
# pipeline, and camera-manager marks the camera unavailable and restarts the
# pipeline after a backoff (ADR-0026 decision 4).
#
# Status: [BENCH] 2026-11-10 on image 6114c52 with two USB webcams
# (bench-log): the socket is agl-driver:f250 0770, the windows show from
# inside the sandbox in the activation area, GStreamer keeps its registry
# in the cache directory, and frames are counted (ADR-0026 decision 3).
[Unit]
Description=F-250 camera manager
After=agl-compositor.service

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=30
User=agl-driver
Group=f250
SupplementaryGroups=video
EnvironmentFile=-/etc/default/f250
Environment=XDG_RUNTIME_DIR=/run/user/1001
Environment=WAYLAND_DISPLAY=wayland-0
ExecStart=/opt/f250/libexec/camera-start
Restart=on-failure
RestartSec=2
# SIGTERM to camera-manager only: it stops its own pipeline (a recording
# pipeline must be finished, not killed: ADR-0027). The rest of the cgroup
# gets SIGKILL only if the stop times out. Before this, systemd's SIGTERM
# also hit gst-launch, camera-manager restarted it, and the stop hung for
# the default 90 s (bench-log 2026-11-10).
KillMode=mixed
TimeoutStopSec=10
UMask=0007
RuntimeDirectory=f250-camera
RuntimeDirectoryMode=0750

# Sandbox (ADR-0021), like the dashboard's, except:
# - Devices: V4L2 cameras only; waylandsink works without the GPU [BENCH].
# - MemoryDenyWriteExecute is on: [BENCH] 2026-11-10 with it, the 640x480
#   MJPEG display pipeline went live and used the same CPU (5.2 % of one
#   core) with no GStreamer warnings. Only that pipeline was tried.
# - No ProcSubset=pid: orc reads /proc/cpuinfo for the CPU's features.
# - Writes: only the cache directory, where GStreamer keeps its plugin
#   registry (XDG_CACHE_HOME); without it every pipeline start rescans the
#   plugins. The real home stays read-only; ProtectHome=yes would hide
#   /run/user and the Wayland socket. agl-driver shares IPC with the
#   compositor and the dashboard, so no RemoveIPC=.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=read-only
MemoryDenyWriteExecute=yes
CacheDirectory=f250-camera
CacheDirectoryMode=0700
Environment=XDG_CACHE_HOME=/var/cache/f250-camera
PrivateTmp=yes
PrivateNetwork=yes
DevicePolicy=closed
DeviceAllow=char-video4linux rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any

[Install]
WantedBy=graphical.target
