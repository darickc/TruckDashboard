# obexd for the phone's cover art (ADR-0042): BlueZ's OBEX daemon on the
# system bus, as user f250, client side only. audio-manager asks it for a
# BIP session to the phone ("bip-avrcp", AVRCP 1.6 cover art) and for each
# track's thumbnail, written to /run/f250-obex/cover-art (obexd creates it
# mode 0600, so it must run as audio-manager's user for audio-manager to
# read it; obexd/client/transfer.c). Started by f250-audio-manager.service.
#
# --noplugin='*': none of obexd's servers (object push, file transfer,
# phonebook, messages) are loaded, so a phone is offered nothing; the client
# (and its BIP part) is not a plugin and stays (obexd/src/main.c,
# obexd/client/manager.c, BlueZ 5.86). --root is the servers' folder, unused.
# The image's own obex.service is a user unit on the session bus; it isn't
# used. f250-obex.conf lets user f250 own org.bluez.obex.
#
# AF_BLUETOOTH works only in the host's network namespace, so no
# PrivateNetwork here (audio-manager has it).
#
# Nothing here touches the vehicle bus (ADR-0007).
#
# Status: [SIM] only; UNVERIFIED on the Pi (ADR-0042, bench check).
[Unit]
Description=F-250 OBEX client for the phone's cover art
Wants=bluetooth.service
After=bluetooth.service dbus.service

[Service]
Type=dbus
BusName=org.bluez.obex
User=f250
Group=f250
ExecStart=/usr/libexec/bluetooth/obexd --system-bus --nodetach --noplugin=* --root=/run/f250-obex/root
Restart=on-failure
RestartSec=5
UMask=0077
RuntimeDirectory=f250-obex f250-obex/root
RuntimeDirectoryMode=0700

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_BLUETOOTH
IPAddressDeny=any
