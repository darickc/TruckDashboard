# Vehicle gateway on AGL (Stage 1 sideload, ADR-0005). The only process that
# talks to the vehicle adapter; everything else uses its gRPC API on
# /run/f250/vehicle.sock (ADR-0002). Settings: /etc/default/f250.
#
# The socket is group f250, mode 0770 (UMask). agl-driver, which runs the
# dashboard, is in that group (agl/scripts/stage1-setup.sh).
#
# Type=notify: READY once the socket is bound, so the recorder and dashboard
# (After=) start against a socket that exists. The watchdog keep-alive goes
# out every 30 s, and only if the control loop has made progress since the
# last one (crates/sd-notify). A loop stuck for 60 s is killed (SIGABRT) and
# Restart= brings it back. The longest legitimate stall is one adapter
# request with the ELM recovery ladder behind it (≈ 20 s); a probe counts
# each of its requests as progress.
#
# Status: [BENCH] on AGL 22.0.1, the watchdog included (bench-log
# 2026-11-06).
[Unit]
Description=F-250 vehicle gateway
After=bluetooth.service
# Traffic logs go on the data drive when DATA_DRIVE=1 (gateway-start). Ordering
# only: the gateway runs without the drive. The mount gives up after 10 s.
After=var-lib-f250-storage.mount

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=60
User=f250
Group=f250
EnvironmentFile=/etc/default/f250
ExecStart=/opt/f250/libexec/gateway-start
Restart=on-failure
RestartSec=2
UMask=0007
RuntimeDirectory=f250
RuntimeDirectoryMode=0750
# The recorder and dashboard are still connected while this restarts.
RuntimeDirectoryPreserve=yes
StateDirectory=f250
StateDirectoryMode=0750
ReadWritePaths=-/var/lib/f250/storage

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
SystemCallArchitectures=native
# unix: gRPC; can: SocketCAN; bluetooth: the MX+ over RFCOMM; inet: tcp: adapters
RestrictAddressFamilies=AF_UNIX AF_CAN AF_BLUETOOTH AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
