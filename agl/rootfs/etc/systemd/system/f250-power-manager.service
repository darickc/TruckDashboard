# Power manager on AGL (Phase 6.7, pulse-only: ADR-0013, power-states.md).
# Reads the power key (the DCDC-USB's PSW pulse on J2, or the Pi 5's own
# button): a press inside the boot window is the supply's ON pulse and is
# ignored; any later press powers the Pi off. logind ignores the key
# (logind.conf.d/50-f250-power-key.conf). It also reads the camera switch:
# the gpio-key overlays in config.txt make its contacts keys F13-F17 on input
# devices (ADR-0025); each debounced move goes to camera-manager's Move call
# on CAMERA_MANAGER (ADR-0026), and what became of it is logged. Calls time
# out; a missing camera-manager never holds up the power key. [SIM] only so
# far.
#
# The service has no privileges. To power off it exits with status 42, and
# ExecStopPost (`+`: as root, outside the sandbox) runs `systemctl poweroff`.
# A crash or a `systemctl stop` doesn't power off.
#
# BOOT_KEY_IGNORE_S (seconds after the kernel started) is an example value,
# overridden in /etc/default/f250. Keep it shorter than the DCDC-USB's
# OFFDELAY, or a quick key cycle's off-pulse is ignored.
#
# Status: [BENCH] on image 288d091 with the Pi's own button (bench-log
# 2026-11-09). The DCDC-USB's PSW on J2 isn't wired yet.
[Unit]
Description=F-250 power manager (power key, pulse-only)

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=30
User=f250
Group=f250
# /dev/input/event* are group input (udev 50-udev-default.rules; the group
# comes from base-passwd).
SupplementaryGroups=input
Environment=BOOT_KEY_IGNORE_S=30
Environment=CAMERA_MANAGER=unix:/run/f250/camera.sock
EnvironmentFile=-/etc/default/f250
ExecStart=/opt/f250/bin/power-manager --boot-key-ignore-s ${BOOT_KEY_IGNORE_S} --camera-manager ${CAMERA_MANAGER}
ExecStopPost=+/opt/f250/libexec/power-manager-stopped
SuccessExitStatus=42
Restart=on-failure
RestartSec=2

# Sandbox (ADR-0021), like the recorder's, except:
# - no PrivateDevices: it reads /dev/input (DeviceAllow below)
# - no ProcSubset=pid: the boot window is measured from /proc/uptime
# - no PrivateUsers: the input group must stay mapped
# AF_UNIX is enough for camera-manager's socket. Connecting needs no write
# access under ProtectSystem=strict: the recorder reaches the gateway's
# socket the same way.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
DevicePolicy=closed
DeviceAllow=char-input r
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
