# Navigation on AGL (Phase 6.4, ADR-0030): the truck's position from gpsd,
# served as f250.nav.v1 on /run/f250-nav/nav.sock (group f250, mode 0770 from
# UMask; agl-driver, which runs the dashboard, is in group f250). Routing
# (6.5.2, ADR-0035): navigation runs valhalla_service once per route, inside
# this sandbox, reading /var/lib/f250/storage/routing/ and writing its config
# to /run/f250-nav/. The sandbox applies to it too: [BENCH] 2026-11-11,
# valhalla_service 3.9.1 routes under it on the Pi 5 (MemoryDenyWriteExecute,
# @system-service minus @privileged @resources, ProtectSystem=strict), in
# 0.13-0.2 s and under 40 MB per request (bench-log). The routing data comes
# on the map stick (ADR-0033 amendment).
#
# gpsd owns the GNSS receiver; navigation is its client on 127.0.0.1:2947
# (NAV_GPSD, navigation-start). gpsd's own socket unit is pulled in, so
# it listens; a missing gpsd shows on the dashboard as "gpsd unavailable".
# NAV_SIMULATE=1 replaces gpsd with a simulated receiver, labelled simulated
# on the screen.
#
# Status: [SIM] (make agl-test, services/navigation's tests against gpsd
# 3.27.5's own output). No receiver chosen yet (H11). UNVERIFIED on the Pi:
# that the image's gpsd.socket listens on 127.0.0.1:2947 and that gpsd-udev
# hands it a USB receiver when one is plugged in.
[Unit]
Description=F-250 navigation (position from gpsd, routes from Valhalla)
Wants=gpsd.socket
After=gpsd.socket gpsd.service

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=30
User=f250
Group=f250
EnvironmentFile=-/etc/default/f250
ExecStart=/opt/f250/libexec/navigation-start
Restart=on-failure
RestartSec=2
UMask=0007
RuntimeDirectory=f250-nav
RuntimeDirectoryMode=0750

# Sandbox (ADR-0021), like the recorder's, except the network: gpsd is a TCP
# server on the loopback interface, so AF_INET/AF_INET6 to localhost only.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressAllow=localhost
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
