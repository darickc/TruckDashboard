# TruckDashboard — F-250 AGL head unit. `make help` lists targets.
#
# Test and lint targets cover only the components that exist. A component that
# hasn't landed yet prints a "skip" line saying which phase adds it, and exits 0.
# Run targets exit non-zero until their phase lands, so they can never look
# like they ran.

SHELL := /bin/bash
ROOT  := $(shell git rev-parse --show-toplevel)

PIO     ?= $(shell command -v pio 2>/dev/null || echo $(HOME)/.platformio/penv/bin/pio)
FLUTTER ?= fvm flutter
# Homebrew's rustup is keg-only; make cargo reachable without shell changes.
# On the Pi, rustup and fvm install into ~/.cargo/bin and ~/fvm/bin.
export PATH := $(shell brew --prefix rustup 2>/dev/null)/bin:$(HOME)/.cargo/bin:$(HOME)/fvm/bin:$(PATH)

FW_DIR  := firmware/esp32
APP_DIR := apps/infotainment
SIM_DIR := simulator/powerstroke

HAVE_CARGO   := $(wildcard Cargo.toml)
HAVE_APP     := $(wildcard $(APP_DIR)/pubspec.yaml)
HAVE_PROTO   := $(wildcard shared/proto/buf.yaml)

skip = @echo "skip: $(1)"

# If the active developer directory is the Command Line Tools but Xcode is
# installed, point Xcode builds at Xcode for this invocation only. (The
# permanent fix is: sudo xcode-select -s /Applications/Xcode.app/Contents/Developer)
XCODE_DEV := $(shell xcode-select -p 2>/dev/null | grep -q CommandLineTools && [ -d /Applications/Xcode.app ] && echo /Applications/Xcode.app/Contents/Developer)
XCODE_ENV := $(if $(XCODE_DEV),DEVELOPER_DIR=$(XCODE_DEV),)

# Simulator start point for ui / ui-web, e.g. SCENARIO=eot_ect_freeze START=110
SCENARIO ?= drive_cycle
START    ?= 0
WEB_PORT ?= 8250
# App data source: sim (in-app simulator) or gateway (services/vehicle-gateway).
SOURCE   ?= sim
GATEWAY  ?= tcp:127.0.0.1:50251
SIM_DEFINES = --dart-define=SCENARIO=$(SCENARIO) --dart-define=SIM_START_S=$(START) \
              --dart-define=VEHICLE_SOURCE=$(SOURCE) --dart-define=GATEWAY=$(GATEWAY)

.PHONY: help setup doctor test lint \
        fw-test fw-build \
        rust-test rust-lint linux-test \
        proto proto-lint \
        ui ui-web ui-macos-build ui-test ui-lint sim-test \
        sim gateway console docs-lint \
        pi-setup pi-build pi-run pi-start pi-stop pi-status pi-can \
        agl-test agl-image deploy deploy-build logs

help: ## List targets
	@grep -hE '^[a-z][a-zA-Z_-]+:.*## ' $(MAKEFILE_LIST) | \
	  awk 'BEGIN {FS = ":.*## "}; {printf "  \033[1m%-12s\033[0m %s\n", $$1, $$2}'

# ---- environment ------------------------------------------------------------

setup: ## Install/check the macOS dev toolchain (Homebrew, rustup, fvm, buf)
	tools/dev/setup-macos.sh

doctor: ## Print tool versions without installing anything
	@echo "rustc:   $$(rustc --version 2>/dev/null || echo missing)"
	@echo "cargo:   $$(cargo --version 2>/dev/null || echo missing)"
	@echo "flutter: $$($(FLUTTER) --version 2>/dev/null | head -1 || echo missing)"
	@echo "protoc:  $$(protoc --version 2>/dev/null || echo missing)"
	@echo "buf:     $$(buf --version 2>/dev/null || echo missing)"
	@echo "pio:     $$($(PIO) --version 2>/dev/null || echo missing)"
	@echo "docker:  $$(docker --version 2>/dev/null || echo missing)"

# ---- aggregate --------------------------------------------------------------

test: fw-test sim-test rust-test ui-test agl-test ## Run every test available in this environment

lint: docs-lint rust-lint proto-lint ui-lint ## Run every linter available

# ---- ESP32 firmware (existing) ---------------------------------------------

fw-test: ## ESP32 host-side unit tests (no hardware)
	cd $(FW_DIR) && $(PIO) test -e native

fw-build: ## Build the ESP32 firmware
	cd $(FW_DIR) && $(PIO) run -e esp32dev

# ---- Rust (Phase 3) ---------------------------------------------------------

rust-test: ## Rust workspace tests
ifneq ($(HAVE_CARGO),)
	cargo test --workspace
else
	$(call skip,rust-test — no Cargo workspace yet (Phase 3))
endif

rust-lint: ## rustfmt + clippy
ifneq ($(HAVE_CARGO),)
	cargo fmt --all -- --check
	cargo clippy --workspace --all-targets -- -D warnings
else
	$(call skip,rust-lint — no Cargo workspace yet (Phase 3))
endif

linux-test: ## Rust tests inside Linux (Docker), including Linux-only code
ifneq ($(HAVE_CARGO),)
	docker run --rm -v "$(ROOT)":/src -w /src -e CARGO_TARGET_DIR=/tmp/target rust:1 bash -c \
	  "apt-get update -qq && apt-get install -y -qq protobuf-compiler libdbus-1-dev pkg-config >/dev/null && \
	   cargo test --workspace && cargo build -p vehicle-gateway --features rfcomm"
else
	$(call skip,linux-test — no Cargo workspace yet (Phase 3))
endif

# ---- protobuf API (Phase 3) -------------------------------------------------

proto: ## Regenerate the Dart gRPC client (Rust is generated by crates/proto/build.rs)
ifneq ($(HAVE_PROTO),)
	cd shared/proto && PATH="$(ROOT)/.fvm/flutter_sdk/bin:$(HOME)/.pub-cache/bin:$$PATH" buf generate
else
	$(call skip,proto — no shared/proto/buf.yaml yet (Phase 3))
endif

proto-lint: ## buf lint
ifneq ($(HAVE_PROTO),)
	cd shared/proto && buf lint
else
	$(call skip,proto-lint — no protos yet (Phase 3))
endif

# ---- Flutter UI (Phase 2) ---------------------------------------------------

ui: ## Run the dashboard on macOS (800x480 window)
ifneq ($(HAVE_APP),)
	cd $(APP_DIR) && $(XCODE_ENV) $(FLUTTER) run -d macos $(SIM_DEFINES)
else
	@echo "ui: the Flutter app does not exist yet (Phase 2)"; exit 1
endif

ui-macos-build: ## Build the macOS app (debug) without running it
ifneq ($(HAVE_APP),)
	cd $(APP_DIR) && $(XCODE_ENV) $(FLUTTER) build macos --debug $(SIM_DEFINES)
else
	@echo "ui-macos-build: the Flutter app does not exist yet (Phase 2)"; exit 1
endif

ui-web: ## Serve the dashboard (release build) at http://127.0.0.1:$(WEB_PORT) — no Xcode needed
ifneq ($(HAVE_APP),)
	cd $(APP_DIR) && $(FLUTTER) run --release -d web-server --web-port $(WEB_PORT) --web-hostname 127.0.0.1 $(SIM_DEFINES)
else
	@echo "ui-web: the Flutter app does not exist yet (Phase 2)"; exit 1
endif

ui-test: ## Flutter widget/unit tests (+ integration tests against the real gateway)
ifneq ($(HAVE_APP),)
ifneq ($(HAVE_CARGO),)
	cargo build -q -p vehicle-gateway
endif
	cd $(APP_DIR) && $(FLUTTER) test -r expanded
else
	$(call skip,ui-test — no Flutter app yet (Phase 2))
endif

sim-test: ## Power Stroke scenario simulator tests (Dart)
	cd $(SIM_DIR) && fvm dart test -r expanded

ui-lint: ## flutter analyze (app + simulator package)
ifneq ($(HAVE_APP),)
	cd $(SIM_DIR) && fvm dart analyze
	cd $(APP_DIR) && $(FLUTTER) analyze
else
	$(call skip,ui-lint — no Flutter app yet (Phase 2))
endif

# ---- docs -------------------------------------------------------------------

docs-lint: ## Check relative Markdown links
	python3 tools/dev/check_links.py

# ---- Raspberry Pi OS, MX+ trial (Phase 3.5); run these on the Pi ------------

# Options for pi-run and pi-start: TRANSPORT=sim|obdlink|can TRANSMIT=1 ADAPTER= CAN_IF= ENABLE= BUDGET_RPS= UI=0|headless
pi-setup: ## On the Pi: install apt packages, Rust and Flutter (Phase 3.5.1)
	tools/pi/setup-raspios.sh

pi-build: ## On the Pi: release-build the gateway (RFCOMM), recorder, obd-console and the Linux app
	@[ "$$(uname -s)" = Linux ] || { echo "pi-build runs on the Pi (Linux); see docs/setup/raspberry-pi.md"; exit 1; }
	cargo build --release -p vehicle-gateway --features rfcomm
	cargo build --release -p recorder -p obd-console
	cd $(APP_DIR) && $(FLUTTER) build linux --release \
	  --dart-define=VEHICLE_SOURCE=gateway --dart-define=GATEWAY=unix:/tmp/f250/vehicle.sock

pi-run: pi-build ## On the Pi: gateway + recorder + fullscreen app (simulator unless TRANSPORT=obdlink|can)
	tools/pi/run.sh

pi-start: pi-build ## On the Pi: pi-run as a systemd service on tty7; works over SSH (same options)
	tools/pi/service.sh start

pi-stop: ## On the Pi: stop the pi-start service cleanly
	tools/pi/service.sh stop

pi-status: ## On the Pi: state and recent log of the pi-start service
	tools/pi/service.sh status

pi-can: ## On the Pi: direct-CAN adapter, CMD=status|listen|active|down|capture|flash (docs/setup/can.md)
	tools/pi/can.sh $(or $(CMD),status) $(SECS)

# ---- not yet available ------------------------------------------------------

gateway: ## Run the vehicle gateway with the simulator (SCENARIO=, START=) on $(GATEWAY)
	cargo run -q -p vehicle-gateway -- --listen $(GATEWAY) --scenario $(SCENARIO) --sim-start-s $(START)

sim: ## Gateway (simulated) + the macOS app reading from it over gRPC
	tools/dev/sim.sh "$(GATEWAY)" "$(SCENARIO)" "$(START)"

console: ## obd-console against the gateway at $(GATEWAY)
	cargo run -q -p obd-console -- --gateway $(GATEWAY)

# ---- AGL (Phase 5); docs/setup/agl.md ---------------------------------------

agl-test: ## Tests for the AGL Stage 1 scripts (no Pi needed)
	tools/dev/test-agl.sh

agl-image: ## Download, verify and decompress the pinned AGL Pi 5 image into build/agl/
	agl/scripts/fetch-image.sh

deploy-build: ## Build the services and dashboard for the Pi 5 (aarch64, in Docker) into build/agl-arm64/
	tools/dev/deploy.sh build

deploy: ## Build, copy to the AGL Pi and set up: make deploy PI=<host> (SKIP_BUILD=1 to reuse the build)
	PI="$(PI)" tools/dev/deploy.sh deploy

logs: ## Collect logs and state from the AGL Pi into build/logs/: make logs PI=<host>
	tools/dev/logs.sh "$(PI)"
